{
  "name": "pharmacy-assistant-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "playwright test",
    "test:accounts": "playwright test --config playwright.accounts.config.ts",
    "test:datasets": "playwright test --config playwright.datasets.config.ts",
    "test:analytics": "playwright test --config playwright.analytics.config.ts",
    "test:dashboards": "playwright test --config playwright.dashboards.config.ts",
    "test:administration": "playwright test --config playwright.administration.config.ts",
    "test:ui": "playwright test --ui",
    "types:api": "openapi-typescript contracts/core.openapi.json -o src/shared/api/generated.ts"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.59.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "7.18.4",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.88.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.4"
  }
}
