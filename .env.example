# Copy this file to .env; add the selected provider's key locally. Never commit .env.
INFERENCE_PROVIDER=groq
# Both running services require their own PostgreSQL URL; no file/SQLite fallback.
# For the existing host setup, the private file below supplies both service URLs.
# Each service loads only its own URL. Docker uses .runtime/compose.env instead.
DATABASE_ENV_FILE=.runtime/postgres.env
STORAGE_BACKEND=postgres
# Core calls this internal service; provider keys and quota access belong to language.
LANGUAGE_SERVICE_URL=http://127.0.0.1:8001
# Total HTTP deadline; no automatic core-side retries (provider may retry once).
LANGUAGE_SERVICE_TIMEOUT_SECONDS=160
# Docker: compose_setup creates ignored .runtime/compose.env from these provider
# settings and existing database credentials. It never overwrites that file.
# See docs/operations/setup.md for the four-container setup.
# Optional local spacing; 0 disables the artificial delay. Provider limits still apply.
INFERENCE_MIN_INTERVAL_SECONDS=0
INFERENCE_QUOTA_SCOPE=default
# Live evaluation shares PostgreSQL quota/budget state through LANGUAGE_DATABASE_URL.
# Old SQLite ledgers remain private; import them only via an explicit admin command.
# Optional secondary provider; its daily quota may be exhausted.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_OUTPUT_TOKENS=4096

# Optional previous provider. Its free tier rejected direct application access.
# Used only when INFERENCE_PROVIDER=opencode.
OPENCODE_API_KEY=
OPENCODE_MODEL=glm-5.3-flash-free
# Strict mode is requested; actual endpoint support still needs a live check.
OPENCODE_OUTPUT_MODE=json_schema
OPENCODE_TIMEOUT_SECONDS=30
OPENCODE_MAX_COMPLETION_TOKENS=2048

# Selected provider. Configure the key locally; never commit it.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Explicit JSON mode with strict local schema/evidence validation; avoids observed Arabic strict-decoder failures.
# Set json_schema to request provider-enforced strict output instead. No automatic downgrade occurs.
GROQ_OUTPUT_MODE=json_object
GROQ_TIMEOUT_SECONDS=20
GROQ_MAX_COMPLETION_TOKENS=1200
